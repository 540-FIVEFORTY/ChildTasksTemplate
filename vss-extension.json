{
	"manifestVersion": 1,
	"id": "ChildTasksTemplate",
	"version": "3.1.9",
	"name": "Child Tasks Template",
	"public": true,
	"publisher": "Fiveforty",
	"description": "Create linked child tasks, bugs or any work item from reusable per-project templates in one click, with parent field values, a visual editor and validation.",
	"targets": [
		{
			"id": "Microsoft.VisualStudio.Services.Cloud"
		}
	],
	"demands": [
		"api-version/5.1"
	],
	"icons": {
		"default": "dist/doc/fiveforty.png"
	},
	"content": {
		"details": {
			"path": "content_details.md"
		},
		"license": {
			"path": "LICENSE"
		}
	},
	"categories": [
		"Azure Boards"
	],
	"scopes": [
		"vso.work_write"
	],
	"contributions": [
		{
			"id": "child-tasks-template-choose",
			"type": "ms.vss-web.external-content",
			"description": "Choose work item creation template",
			"targets": [],
			"properties": {
				"uri": "dist/src-modern/chooseTemplate/index.html"
			}
		},
		{
			"id": "child-tasks-template-action",
			"type": "ms.vss-web.action",
			"description": "Add child tasks from the template defined in the project settings.",
			"targets": [
				"ms.vss-work-web.work-item-context-menu",
				"ms.vss-work-web.query-result-work-item-menu",
				"ms.vss-work-web.work-item-toolbar-menu",
				"ms.vss-work-web.backlog-item-menu"
			],
			"properties": {
				"text": "Add tasks",
				"toolbarText": "Add tasks",
				"title": "Creates child tasks from the defined template.",
				"uri": "dist/src-modern/extension/index.html"
			}
		},
		{
			"id": "child-tasks-template-settings",
			"type": "ms.vss-web.hub",
			"targets": [
				"ms.vss-web.project-admin-hub-group"
			],
			"includes": [
				"ms.vss-tfs-web.tfs-page-data-service",
				"ms.vss-features.host-navigation-service",
				"ms.vss-features.extension-data-service",
				"ms.vss-features.host-dialog-service"
			],
			"properties": {
				"name": "Child Tasks Template",
				"uri": "dist/src-modern/settings/index.html",
				"supportsMobile": true
			}
		}
	],
	"files": [
		{
			"path": "dist",
			"addressable": true
		}
	],
	"links": {
		"support": {
			"uri": "mailto:dbru@fiveforty.fr"
		},
		"home": {
			"uri": "https://github.com/dbru540/ChildTasksTemplate"
		},
		"getstarted": {
			"uri": "https://github.com/dbru540/ChildTasksTemplate"
		},
		"learn": {
			"uri": "https://github.com/dbru540/ChildTasksTemplate"
		},
		"repository": {
			"uri": "https://github.com/dbru540/ChildTasksTemplate"
		},
		"issues": {
			"uri": "https://github.com/dbru540/ChildTasksTemplate/issues"
		}
	},
	"tags": [
		"Tasks",
		"Child tasks",
		"Template",
		"Work items",
		"Azure Boards",
		"Productivity",
		"Automation"
	],
	"repository": {
		"type": "git",
		"uri": "https://github.com/dbru540/ChildTasksTemplate.git"
	},
	"screenshots": [
		{
			"path": "dist/doc/add_child_tasks_screen.png"
		}
	]
}
