{
	"$schema": "http://json-schema.org/draft-07/schema",
	"$id": "http://example.com/example.json",
	"type": "object",
	"title": "Template Setup Schema",
	"description": "Schema for Child Tasks Template configuration",
	"default": {},
	"examples": [
		{
			"version": 3,
			"templates": [
				{
					"name": "Development",
					"tasks": [
						{
							"name": "Design",
							"workItemType": "Task",
							"fields": [
								{ "name": "System.IterationPath", "value": "{System.IterationPath}" },
								{ "name": "Microsoft.VSTS.Common.Activity", "value": "Design" }
							]
						}
					]
				}
			]
		}
	],
	"required": [
		"version",
		"templates"
	],
	"properties": {
		"version": {
			"$id": "#/properties/version",
			"type": "integer",
			"title": "Version",
			"description": "Schema version number",
			"default": 3,
			"examples": [3]
		},
		"templates": {
			"$id": "#/properties/templates",
			"type": "array",
			"title": "Templates",
			"description": "List of task templates",
			"default": [],
			"items": {
				"type": "object",
				"required": ["name", "tasks"],
				"properties": {
					"name": {
						"type": "string",
						"title": "Template Name",
						"examples": ["Development", "Bug Fix"]
					},
					"tasks": {
						"type": "array",
						"title": "Tasks",
						"items": {
							"type": "object",
							"required": ["name", "fields"],
							"properties": {
								"name": {
									"type": "string",
									"title": "Task Name",
									"examples": ["Design", "Development", "Testing"]
								},
								"workItemType": {
									"type": "string",
									"title": "Work Item Type",
									"default": "Task",
									"examples": ["Task", "Bug"]
								},
								"fields": {
									"type": "array",
									"title": "Fields",
									"items": {
										"type": "object",
										"required": ["name"],
										"properties": {
											"name": {
												"type": "string",
												"title": "Field Name",
												"examples": ["System.IterationPath", "Microsoft.VSTS.Common.Activity"]
											},
											"value": {
												"type": "string",
												"title": "Field Value",
												"examples": ["{System.IterationPath}", "Design", "4"]
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
