{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Paths */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src-modern/*"],
      "@core/*": ["./src-modern/core/*"],
      "@features/*": ["./src-modern/features/*"],
      "@shared/*": ["./src-modern/shared/*"],
      "@config/*": ["./src-modern/config/*"]
    }
  },
  "include": ["src-modern"],
  "exclude": ["src-modern/**/*.test.ts", "src-modern/**/*.spec.ts", "src-modern/test"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
