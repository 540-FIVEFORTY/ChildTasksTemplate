{
    "name": "child-tasks-template",
    "version": "1.0.0",
    "description": "",
    "private": true,
    "main": "src/app.js",
    "scripts": {
        "clean": "rimraf ./dist ./bin",
        "compile": "npm run clean && webpack --mode production",
        "compile:dev": "npm run clean && webpack --mode development",
        "package": "npm run compile && tfx extension create --output-path ./bin --manifest-globs vss-extension.json",
        "package:dev": "npm run compile:dev && tfx extension create --output-path ./bin --manifest-globs vss-extension.json --overrides-file vss-extension-dev.json",
        "publish": "npm run compile && tfx extension publish --output-path ./bin --manifest-globs vss-extension.json",
        "publish:dev": "npm run compile:dev && tfx extension publish --output-path ./bin --manifest-globs vss-extension.json --overrides-file vss-extension-dev.json",
        "start:dev": "webpack serve --mode development --env development --port 6221"
    },
    "dependencies": {
        "ajv": "^8.17.1",
        "react": "^16.8.1",
        "react-dom": "^16.8.1"
    },
    "devDependencies": {
        "@types/jest": "^29.5.12",
        "@types/jquery": "^3.5.30",
        "@types/jsoneditor": "^9.9.5",
        "@types/node": "^20.14.0",
        "@types/react": "^16.14.60",
        "@types/react-dom": "^16.9.24",
        "@typescript-eslint/eslint-plugin": "^7.13.0",
        "@typescript-eslint/parser": "^7.13.0",
        "azure-devops-extension-api": "^4.263.0",
        "azure-devops-extension-sdk": "^4.2.0",
        "azure-devops-ui": "^2.167.97",
        "clean-webpack-plugin": "^4.0.0",
        "copy-webpack-plugin": "^12.0.2",
        "css-loader": "^7.1.2",
        "eslint": "^8.57.0",
        "file-loader": "^6.2.0",
        "html-webpack-plugin": "^5.6.0",
        "jsoneditor": "^10.1.0",
        "pupa": "^3.1.0",
        "resolve-url-loader": "^5.0.0",
        "rimraf": "^5.0.7",
        "sass": "^1.77.4",
        "sass-loader": "^14.2.1",
        "style-loader": "^4.0.0",
        "tfx-cli": "^0.17.0",
        "ts-loader": "^9.5.1",
        "typescript": "^5.4.5",
        "url-loader": "^4.1.1",
        "webpack": "^5.91.0",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.0.4"
    }
}
